# The root of backend api. Have to match the SITE_ROOT value on openIMIS backend
REACT_APP_API_URL=api
# OpenSearch proxy base root path
OPENSEARCH_PROXY_ROOT="opensearch"
# No longer used by this image: the /opensearch/ gate authenticates by the
# identity headers it gets from the rights check, and presents no credential.
# Kept, and kept defined, only because a deployment may mount an older
# conf/nginx that still references it, which envsubst would otherwise leave
# literal and nginx would refuse to start on.
OPENSEARCH_BASIC_TOKEN=""

PUBLIC_URL=/front
REACT_APP_API_URL=/api
API_PROXY_TARGET="http://localhost:8000"
REACT_APP_SENTRY_DSN=""